# API
PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mestryx_platform
REDIS_URL=redis://localhost:6379

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-long!!
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:5174,http://localhost:3002,http://localhost:3001
# Google OAuth (FB-068 / F-108). Without keys, email/password only.
# Callback: ${BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple Sign In (FB-072 / F-110). Services ID + client secret JWT.
# Callback: ${BETTER_AUTH_URL}/api/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Hosts — fork placeholders (replace with your domains)
# ---------------------------------------------------------------------------
PUBLIC_ADMIN_HOST=admin.example.com
PUBLIC_API_HOST=api.example.com
PUBLIC_SITES_HOST_SUFFIX=sites.example.com
PUBLIC_PLATFORM_HOST=platform.example.com

# ---------------------------------------------------------------------------
# Hosts — upstream Mestryx demo hosts (optional; leave commented in forks)
# ---------------------------------------------------------------------------
# PUBLIC_ADMIN_HOST=admin.mestryx.dev
# PUBLIC_API_HOST=api.mestryx.dev
# PUBLIC_SITES_HOST_SUFFIX=sites.mestryx.dev
# PUBLIC_PLATFORM_HOST=mestryx.dev

# Hosts — staging (Q9)
# PUBLIC_ADMIN_HOST=admin.staging.mestryx.dev
# PUBLIC_API_HOST=api.staging.mestryx.dev
# PUBLIC_SITES_HOST_SUFFIX=sites.staging.mestryx.dev

# Local admin / web (dev)
ADMIN_ORIGIN=http://localhost:5174
WEB_ORIGIN=http://localhost:3002

# Public SSR listens on 3002 by default (3000 often used by other local tools)
# SECURITY_CSP=   # empty disables CSP; unset = defaults (FB-098)
# WEB_PORT=3002
# Local shop without DNS: paste site UUID from admin after creating a site
# Or run: pnpm db:seed  (prints WEB_DEV_SITE_ID for Luna Bijoux internal trial)
# WEB_DEV_SITE_ID=
# API_URL=http://localhost:3001
# SEED_EMAIL=demo@lunabijoux.local
# SEED_PASSWORD=change-me-local-only   # REQUIRED for pnpm db:seed (no default in source)
# Demo hosts only (Dokploy demo API / Admin) — never on merchant prod:
# DEMO_MODE=true
# Admin Vite build arg: VITE_DEMO_MODE=true

# Email — Resend (FB-067). Without RESEND_API_KEY, emails are log-only.
# RESEND_API_KEY=re_...
# EMAIL_FROM=noreply@example.com
# SMTP_HOST=localhost
# SMTP_PORT=1025

# Object storage — R2/S3 (FB-064). Without keys, register external URLs only.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://media.example.com
# S3_REGION=auto

# Observability
# SENTRY_DSN=
LOG_LEVEL=info

# Stripe (test mode only — Q13; never live without human confirm)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
