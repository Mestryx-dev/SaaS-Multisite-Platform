{
  "name": "mestryx-multisite-platform",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mestryx/api --filter=@mestryx/admin",
    "dev:all": "turbo run dev --filter=@mestryx/api --filter=@mestryx/admin --filter=@mestryx/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "ds:detect": "npx impeccable detect packages/ui/src --json",
    "ds:detect:all": "npx impeccable detect packages/ui/src apps/admin/src apps/web/src apps/marketing/src --json",
    "dev:api": "pnpm --filter @mestryx/api dev",
    "dev:admin": "pnpm --filter @mestryx/admin dev",
    "dev:web": "pnpm --filter @mestryx/web dev",
    "dev:marketing": "pnpm --filter @mestryx/marketing dev",
    "dev:remotion": "pnpm --filter @mestryx/remotion studio",
    "render:remotion": "pnpm --filter @mestryx/remotion render",
    "build:api": "pnpm --filter @mestryx/api build",
    "db:seed": "pnpm --filter @mestryx/api db:seed",
    "render:remotion:product": "pnpm --filter @mestryx/remotion render:product",
    "render:remotion:brand": "pnpm --filter @mestryx/remotion render:brand",
    "render:remotion:all": "pnpm --filter @mestryx/remotion render:all"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}
