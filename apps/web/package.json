{
  "name": "@mestryx/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/i18n/locales dist/client && cp src/i18n/locales/*.json dist/i18n/locales/ && cp src/client/*.js dist/client/",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@mestryx/host-resolution": "workspace:*",
    "@mestryx/tokens": "workspace:*",
    "@mestryx/ui": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@mestryx/config": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
