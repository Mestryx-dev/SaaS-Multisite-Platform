---
interface Props {
  adminLabel: string;
  storeLabel: string;
  caption: string;
}

const { adminLabel, storeLabel, caption } = Astro.props;
---

<figure class="product-stage" data-motion="stage" aria-label={caption}>
  <div class="product-stage__glow" data-motion="glow" aria-hidden="true"></div>
  <div class="product-stage__frame">
    <div class="product-stage__chrome">
      <span class="product-stage__dot" aria-hidden="true"></span>
      <span class="product-stage__dot" aria-hidden="true"></span>
      <span class="product-stage__dot" aria-hidden="true"></span>
      <span class="product-stage__url">{caption}</span>
    </div>
    <svg
      class="product-stage__svg"
      viewBox="0 0 720 420"
      role="img"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect width="720" height="420" fill="#0b0f14" />
      <!-- Admin panel -->
      <g>
        <rect x="24" y="28" width="300" height="364" rx="10" fill="#0f172a" stroke="#334155" />
        <rect x="24" y="28" width="72" height="364" rx="10" fill="#0f172a" />
        <rect x="36" y="48" width="48" height="8" rx="2" fill="#5eead4" opacity="0.85" />
        <rect x="36" y="76" width="40" height="6" rx="2" fill="#334155" />
        <rect x="36" y="96" width="40" height="6" rx="2" fill="#334155" />
        <rect x="36" y="116" width="40" height="6" rx="2" fill="#5eead4" opacity="0.45" />
        <rect x="36" y="136" width="40" height="6" rx="2" fill="#334155" />
        <rect x="112" y="48" width="180" height="14" rx="3" fill="#e2e8f0" opacity="0.9" />
        <rect x="112" y="72" width="120" height="8" rx="2" fill="#94a3b8" opacity="0.7" />
        <rect x="112" y="108" width="188" height="56" rx="8" fill="#1e293b" stroke="#334155" />
        <rect x="112" y="180" width="188" height="56" rx="8" fill="#1e293b" stroke="#334155" />
        <rect x="112" y="252" width="88" height="56" rx="8" fill="#1e293b" stroke="#334155" />
        <rect x="212" y="252" width="88" height="56" rx="8" fill="#1e293b" stroke="#334155" />
        <text x="112" y="360" fill="#5eead4" font-size="13" font-family="Inter, system-ui, sans-serif" font-weight="600">
          {adminLabel}
        </text>
      </g>
      <!-- Storefront panel -->
      <g>
        <rect x="348" y="28" width="348" height="364" rx="10" fill="#f8fafc" stroke="#e2e8f0" />
        <rect x="348" y="28" width="348" height="48" fill="#ffffff" />
        <rect x="364" y="44" width="72" height="10" rx="2" fill="#115e59" />
        <rect x="560" y="42" width="48" height="14" rx="4" fill="#115e59" />
        <rect x="620" y="42" width="48" height="14" rx="4" fill="#e2e8f0" />
        <rect x="364" y="100" width="316" height="120" rx="8" fill="#0f172a" />
        <rect x="380" y="148" width="140" height="12" rx="2" fill="#5eead4" opacity="0.9" />
        <rect x="380" y="172" width="100" height="8" rx="2" fill="#94a3b8" />
        <rect x="364" y="240" width="96" height="112" rx="8" fill="#ffffff" stroke="#e2e8f0" />
        <rect x="474" y="240" width="96" height="112" rx="8" fill="#ffffff" stroke="#e2e8f0" />
        <rect x="584" y="240" width="96" height="112" rx="8" fill="#ffffff" stroke="#e2e8f0" />
        <text x="364" y="380" fill="#115e59" font-size="13" font-family="Inter, system-ui, sans-serif" font-weight="600">
          {storeLabel}
        </text>
      </g>
    </svg>
  </div>
  <figcaption class="product-stage__caption">{caption}</figcaption>
</figure>
