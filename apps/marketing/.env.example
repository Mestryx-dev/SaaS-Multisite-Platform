# Marketing site — all `PUBLIC_*` are Astro build-time (Docker build-args on Dokploy).
# Leave Umami empty to disable analytics entirely (recommended default for forks).

# ---------------------------------------------------------------------------
# Fork placeholders — set these for your deployment (or leave empty)
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://example.com
PUBLIC_CONTACT_EMAIL=contact@example.com
PUBLIC_LINK_DEMO_ADMIN=
PUBLIC_LINK_DEMO_STORE=
PUBLIC_LINK_PORTFOLIO=

# Optional analytics (self-hosted Umami). Unset = no script injected.
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SHARE_URL=
# Optional override for privacy copy (defaults to origin of SCRIPT_URL)
PUBLIC_ANALYTICS_HOST=

# ---------------------------------------------------------------------------
# Upstream Mestryx dogfood (build-args on Mestryx Dokploy only — do not commit secrets)
# ---------------------------------------------------------------------------
# PUBLIC_SITE_URL=https://mestryx.dev
# PUBLIC_CONTACT_EMAIL=contact@mestryx.dev
# PUBLIC_LINK_DEMO_ADMIN=https://demo-admin-platform.mestryx.dev
# PUBLIC_LINK_DEMO_STORE=https://demo-web-platform.mestryx.dev
# PUBLIC_LINK_PORTFOLIO=https://portfolio.mestryx.dev
# PUBLIC_UMAMI_SCRIPT_URL=https://umami.mestryx.dev/script.js
# PUBLIC_UMAMI_WEBSITE_ID=   # from operator vault / Dokploy — never commit real UUID
# PUBLIC_UMAMI_SHARE_URL=
