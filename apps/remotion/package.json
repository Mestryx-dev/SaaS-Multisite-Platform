{
  "name": "@mestryx/remotion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render src/index.ts MestryxPromo out/mestryx-promo.mp4",
    "render:still": "remotion still src/index.ts MestryxPromo out/mestryx-promo.png",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "bundle": "remotion bundle src/index.ts --out-dir dist/bundle",
    "test": "echo \"no remotion unit tests yet\"",
    "render:product": "remotion render src/index.ts ProductPromo out/product-promo.mp4",
    "render:brand": "remotion render src/index.ts BrandLaunch out/brand-launch.mp4",
    "render:all": "mkdir -p out && pnpm run render && pnpm run render:product && pnpm run render:brand",
    "ci:render": "pnpm run render:all"
  },
  "dependencies": {
    "@mestryx/tokens": "workspace:*",
    "@remotion/bundler": "4.0.505",
    "@remotion/cli": "4.0.505",
    "@remotion/renderer": "4.0.505",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.505",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mestryx/config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
