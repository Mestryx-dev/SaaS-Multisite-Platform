---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t } from "../../i18n";
import { localeStaticPaths, resolveLocale } from "../../lib/locale";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = resolveLocale(Astro.params.locale);
---

<BaseLayout locale={locale} title={t(locale, "legal.mentions.title")}>
  <article class="legal-page shell">
    <p class="draft-banner">{t(locale, "legal.draftBanner")}</p>
    <h1>{t(locale, "legal.mentions.title")}</h1>
    <h2>{t(locale, "legal.mentions.editor")}</h2>
    <p>{t(locale, "legal.mentions.editorBody")}</p>
    <h2>{t(locale, "legal.mentions.hosting")}</h2>
    <p>{t(locale, "legal.mentions.hostingBody")}</p>
    <h2>{t(locale, "legal.mentions.contact")}</h2>
    <p>{t(locale, "legal.mentions.contactBody")}</p>
  </article>
</BaseLayout>
